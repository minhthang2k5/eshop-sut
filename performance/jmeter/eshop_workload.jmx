              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">import groovy.json.JsonOutput
import java.util.concurrent.ThreadLocalRandom
def products = vars.getObject(&apos;products&apos;)
def product = products[ThreadLocalRandom.current().nextInt(products.size())]
vars.put(&apos;keyword&apos;, product[6])
vars.put(&apos;product_id&apos;, product[0])
vars.put(&apos;checkout_body&apos;, JsonOutput.toJson([total_amount:new BigDecimal(product[2]), shipping_address:&apos;42 Nguyen Hue - Ho Chi Minh City (synthetic test address)&apos;]))
</stringProp>
