  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="EShop Week 2 - Assignee B">
      <stringProp name="TestPlan.comments">D3: login once; independent per-user throughput controllers 55/25/20; stop thread on assertion failure; no cart/admin traffic.</stringProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="User Defined Variables">
        <collectionProp name="Arguments.arguments">
          <elementProp name="host" elementType="Argument">
